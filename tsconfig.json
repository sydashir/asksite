{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["packages/*/src", "packages/*/test", "packages/renderer/scripts", "packages/site-css/scripts", "packages/generation/eval", "apps/generator/src", "apps/generator/test", "fixtures", "scripts", "vitest.config.ts"],
  "exclude": ["packages/mailer", "packages/publishing", "apps/sites"]
}
