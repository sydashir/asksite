{
  "name": "asksite-app-test",
  "main": "./support/test-worker.ts",
  "compatibility_date": "2026-09-21",
  "workers_dev": false,
  "preview_urls": false,
  "dev": { "local_protocol": "https" },
  "vars": {
    "ENVIRONMENT": "development",
    "ROOT_DOMAIN": "localhost:8789",
    "APP_ORIGIN": "https://app.localhost:8787",
    "MAILER": "log",
    "MAIL_FROM": "Test <test@mail.localhost>",
    "ADMIN_NOTIFY_EMAILS": "reviewer@example.com",
    "GENERATION_ENABLED": "true",
    "DAILY_MODEL_LIMIT": "30",
    "RESEND_API_KEY": "unused-in-tests",
    "IP_HASH_KEY": "test-ip-hash-key"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "asksite",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../../packages/core/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "WORK", "bucket_name": "asksite-work" },
    { "binding": "MEDIA", "bucket_name": "asksite-media" }
  ],
  "queues": { "producers": [{ "binding": "GEN_QUEUE", "queue": "asksite-generation" }] },
  "images": { "binding": "IMAGES" },
  "ratelimits": [
    { "name": "AUTH_RL", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "API_RL", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    { "name": "UPLOAD_RL", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ]
}
