{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "asksite-app",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-21",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "assets": { "directory": "./dist/client", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "routes": [{ "pattern": "app.asksite.example/*", "zone_name": "asksite.example" }],
  "triggers": { "crons": ["0 6 * * *"] },
  "vars": {
    "ENVIRONMENT": "production",
    "ROOT_DOMAIN": "asksite.example",
    "APP_ORIGIN": "https://app.asksite.example",
    "MAILER": "resend",
    "MAIL_FROM": "Website team <hello@mail.asksite.example>",
    "SUPPORT_EMAIL": "help@asksite.example",
    "ADMIN_NOTIFY_EMAILS": "",
    "GENERATION_ENABLED": "false",
    "DAILY_MODEL_LIMIT": "8",
    "TURNSTILE_SITE_KEY": "",
    "LOGIN_EMAILS_PER_DAY": "40"
  },
  "secrets": { "required": ["RESEND_API_KEY", "IP_HASH_KEY", "TURNSTILE_SECRET_KEY"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "asksite",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/core/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "WORK", "bucket_name": "asksite-work" },
    { "binding": "MEDIA", "bucket_name": "asksite-media" }
  ],
  "queues": { "producers": [{ "binding": "GEN_QUEUE", "queue": "asksite-generation" }] },
  "images": { "binding": "IMAGES" },
  "ratelimits": [
    { "name": "AUTH_RL", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "API_RL", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    { "name": "UPLOAD_RL", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ]
}
