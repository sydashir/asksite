# Local development values (copied to .dev.vars, which is gitignored). "dev" sign-in works only on
# *.localhost host names; production uses Cloudflare Access.
ENVIRONMENT=development
ROOT_DOMAIN=localhost:8789
APP_ORIGIN=https://app.localhost:8787
ADMIN_ORIGIN=https://admin.localhost:8788
MAILER=log
MAIL_FROM=Local test <test@mail.localhost>
SUPPORT_EMAIL=help@example.com
GENERATION_ENABLED=true
DAILY_MODEL_LIMIT=8
LOGIN_EMAILS_PER_DAY=40
ADMIN_AUTH_MODE=dev
DEV_ADMIN_EMAIL=admin@example.com
ADMIN_EMAILS=admin@example.com
MODEL_PROVIDER=fake
MODEL_ID=fake-template
RESEND_API_KEY=unused-in-development
